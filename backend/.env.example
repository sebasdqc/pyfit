SECRET_KEY=django-insecure-cambia-esto-en-produccion
DEBUG=False
DATABASE_URL=postgresql://user:password@host:5432/pyfit
GROQ_API_KEY=gsk_...
ALLOWED_HOSTS=tu-app.ondigitalocean.app,localhost
CORS_ALLOWED_ORIGINS=https://pyfit.app,http://localhost:3000,http://localhost:8081
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu@gmail.com
EMAIL_HOST_PASSWORD=app-password-de-gmail
FRONTEND_URL=https://pyfit.app

# ── Garmin Connect OAuth 2.0 ─────────────────────────────────────────────────
# Registro en https://developer.garmin.com/gc-developer-program/overview/
GARMIN_CLIENT_ID=tu-client-id-garmin
GARMIN_CLIENT_SECRET=tu-client-secret-garmin
GARMIN_OAUTH_BASE_URL=https://connect.garmin.com
GARMIN_API_BASE_URL=https://apis.garmin.com
# Deep link de retorno a la app Expo (registrar en Garmin Developer Portal)
GARMIN_REDIRECT_URI=zyfit://garmin/callback

# ── Encriptación de tokens OAuth (django-cryptography) ───────────────────────
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=tu-clave-fernet-base64=

# ── Celery — broker Redis para sync diario de Garmin ─────────────────────────
# En DigitalOcean: aprovisionar un Redis Managed Database y copiar la URL aquí.
# En local con Docker: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
