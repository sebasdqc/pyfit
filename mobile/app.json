{
  "expo": {
    "name": "Zyfit",
    "slug": "pyfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.pyfit.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Zyfit necesita tu ubicación para registrar tu carrera.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Zyfit necesita tu ubicación en segundo plano para continuar registrando tu carrera con la pantalla apagada.",
        "NSHealthShareUsageDescription": "Zyfit lee datos de salud para personalizar tus entrenamientos.",
        "NSHealthUpdateUsageDescription": "Zyfit puede registrar tus entrenamientos en Apple Health.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "app.pyfit.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "pyfit",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bc0530b3-44d7-42e6-9ae7-74148801fa88"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "AppCheckCore", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zyfit necesita acceder a tus fotos para que elijas una imagen de perfil o de tu sesión de entrenamiento.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Zyfit necesita tu ubicación en segundo plano para continuar registrando tu carrera con la pantalla apagada.",
          "locationAlwaysPermission": "Zyfit necesita tu ubicación en segundo plano para continuar registrando tu carrera con la pantalla apagada.",
          "locationWhenInUsePermission": "Zyfit necesita tu ubicación para registrar tu carrera.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@sentry/react-native/expo",
      "expo-video",
      "expo-notifications",
      "expo-localization",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1091874402206-ig425bden5sh6uctaaal28b07flrkvco"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bc0530b3-44d7-42e6-9ae7-74148801fa88"
      }
    },
    "owner": "sebasdqc"
  }
}
