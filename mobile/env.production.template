EXPO_PUBLIC_API_URL=https://sea-lion-app-a2j4f.ondigitalocean.app

# Sentry — pega aquí la DSN del proyecto Zyfit-mobile cuando esté creado
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production

# Google Sign-In (Google Cloud Console → APIs & Services → Credentials)
# - WEB: client ID de tipo "Web application". Firma el idToken → el backend lo
#        valida (GOOGLE_OAUTH_CLIENT_IDS debe incluirlo).
# - IOS: client ID de tipo "iOS" (bundle app.pyfit.mobile). Su versión invertida
#        va en app.json → plugin google-signin → iosUrlScheme.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
